{
  "name": "qietuzai",
  "productName": "切图仔",
  "version": "0.1.1",
  "description": "GPT 生图桌面客户端（img.sh 的 GUI 版）",
  "homepage": "https://github.com/jerry1zhang/qietuzai",
  "desktopName": "qietuzai.desktop",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "build:renderer": "vite build",
    "test": "node --test test/*.test.js",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "author": "qietuzai",
  "build": {
    "appId": "com.qietuzai.app",
    "productName": "切图仔",
    "artifactName": "qietuzai-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "切图仔"
    },
    "portable": {
      "artifactName": "qietuzai-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "executableName": "qietuzai",
      "icon": "build/icon.png",
      "synopsis": "GPT 生图桌面客户端",
      "maintainer": "qietuzai",
      "syncDesktopName": true
    }
  }
}
